# Studiobook environment.
#
# For a zero-setup local run, skip all of this and use the seeded in-memory
# backends instead:  USE_FAKE_BACKENDS=1  (see `pnpm dev:fake`).

# --- Supabase (Postgres, server-side data access) ---
# `pnpm db:start` prints these for the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_local_key
SUPABASE_SECRET_KEY=sb_secret_your_local_key

# --- Email (Cloudflare Email) ---
# Optional locally (Supabase Inbucket captures mail). Required to send for real.
CF_EMAIL_API_TOKEN=

# --- Dev session cookie (magic-link stub) ---
STUDIOBOOK_SESSION_SECRET=change-me-in-real-deployments

# --- Fake backends: seeded in-memory repositories + fake email (no Supabase) ---
# USE_FAKE_BACKENDS=1
