# Studiobook environment.
#
# For a zero-setup local run, skip all of this and use the seeded in-memory
# backends instead:  USE_FAKE_BACKENDS=1  (see `pnpm dev:fake`).
#
# Persistence is Cloudflare D1, bound directly by Wrangler — no env vars needed
# locally. `wrangler dev` provisions a local SQLite-backed D1 automatically.

# --- Email (Resend) ---
# Optional locally (fake mode uses a no-op provider). Required to send for real.
RESEND_API_KEY=re_your_api_key
STUDIOBOOK_FROM_EMAIL=Studiobook <hello@yourdomain.com>

# --- Dev session cookie (magic-link stub) ---
STUDIOBOOK_SESSION_SECRET=change-me-in-real-deployments

# --- Fake backends: seeded in-memory repositories + fake email (no D1 needed) ---
# USE_FAKE_BACKENDS=1
