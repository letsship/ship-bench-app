{
  "extends": "@studiobook/config-typescript/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "next-env.d.ts"],
  "exclude": [
    "node_modules",
    ".next",
    ".open-next",
    "e2e",
    "playwright.config.ts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
