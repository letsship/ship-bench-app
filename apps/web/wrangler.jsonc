{
  // Production wrangler config for Studiobook (a benchmark fixture app).
  // Deploys apps/web as a Cloudflare Worker via @opennextjs/cloudflare.
  //
  // NEXT_PUBLIC_* vars are public (inlined into the client bundle at build time).
  // The RESEND_API_KEY secret is set out-of-band with
  // `wrangler secret put <NAME>` — never commit it.
  "name": "studiobook",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook",
      "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://studiobook.example",
  },
  "observability": {
    "enabled": true,
  },
}
