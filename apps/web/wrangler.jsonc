{
  // Production wrangler config for Studiobook (a benchmark fixture app).
  // Deploys apps/web as a Cloudflare Worker via @opennextjs/cloudflare.
  //
  // NEXT_PUBLIC_* vars are public (inlined into the client bundle at build time).
  // The RESEND_API_KEY secret is set out-of-band with `wrangler secret put
  // RESEND_API_KEY` — never commit it. Persistence is the D1 binding below —
  // provision it with `wrangler d1 create studiobook` and fill in database_id.
  "name": "studiobook",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://studiobook.example",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook",
      "database_id": "REPLACE_ME_WITH_WRANGLER_D1_CREATE_OUTPUT",
      "migrations_dir": "../../packages/db/migrations/d1",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
