{
  // Production wrangler config for Studiobook (a benchmark fixture app).
  // Deploys apps/web as a Cloudflare Worker via @opennextjs/cloudflare.
  //
  // NEXT_PUBLIC_* vars are public (inlined into the client bundle at build time).
  // The secrets SUPABASE_SECRET_KEY, CF_EMAIL_API_TOKEN, and CF_ACCOUNT_ID are
  // set out-of-band with `wrangler secret put <NAME>` — never commit them.
  "name": "studiobook",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://YOUR-PROJECT.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_REPLACE_ME",
    "NEXT_PUBLIC_SITE_URL": "https://studiobook.example",
  },
  "observability": {
    "enabled": true,
  },
}
