{
  // Production wrangler config for Studiobook (a benchmark fixture app).
  // Deploys apps/web as a Cloudflare Worker via @opennextjs/cloudflare.
  //
  // Persistence is Cloudflare D1 (SQLite) bound as `DB` and accessed through the
  // Drizzle ORM repository adapter (lib/db/repos/d1.ts). The D1 database is
  // created from the migrations under apps/web/migrations. `database_id` is a
  // placeholder — the real id is filled when the D1 instance is provisioned
  // (preview deploys rewrite it via the deploy-preview workflow).
  //
  // NEXT_PUBLIC_* vars are public (inlined into the client bundle at build time).
  // The secret RESEND_API_KEY is set out-of-band with `wrangler secret put
  // <NAME>` — never commit it.
  "name": "studiobook",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://studiobook.example",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
