{
  // Production wrangler config for Studiobook (a benchmark fixture app).
  // Deploys apps/web as a Cloudflare Worker via @opennextjs/cloudflare.
  //
  // NEXT_PUBLIC_* vars are public (inlined into the client bundle at build time).
  // The secrets SUPABASE_SECRET_KEY and RESEND_API_KEY are set out-of-band with
  // `wrangler secret put <NAME>` — never commit them.
  "name": "studiobook",
  "main": ".open-next/worker.js",
  // 2025-08-16+ is required so the runtime exposes node:http/node:https,
  // which @sentry/nextjs needs to actually send captured events — see
  // https://docs.sentry.io/platforms/javascript/guides/cloudflare/frameworks/nextjs/
  "compatibility_date": "2025-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://YOUR-PROJECT.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_REPLACE_ME",
    "NEXT_PUBLIC_SITE_URL": "https://studiobook.example",
  },
  "observability": {
    "enabled": true,
  },
}
