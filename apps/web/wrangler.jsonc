{
  // Production wrangler config for Studiobook (a benchmark fixture app).
  // Deploys apps/web as a Cloudflare Worker via @opennextjs/cloudflare.
  "name": "studiobook",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook",
      // Replace with your D1 database id (`wrangler d1 create studiobook`).
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "drizzle",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
