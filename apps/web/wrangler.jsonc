{
  // Production wrangler config for Studiobook (a benchmark fixture app).
  // Deploys apps/web as a Cloudflare Worker via @opennextjs/cloudflare.
  //
  // The app's persistence lives in the `DB` Cloudflare D1 binding (created and
  // migrated with `wrangler d1 migrations apply`). The D1 schema is shipped
  // under ./migrations. `RESEND_API_KEY` (and any other email secret) is set
  // out-of-band with `wrangler secret put <NAME>` — never commit it.
  "name": "studiobook",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://studiobook.example",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
