{
  // Production wrangler config for Studiobook (a benchmark fixture app).
  // Deploys apps/web as a Cloudflare Worker via @opennextjs/cloudflare.
  //
  // The D1 database is created via `wrangler d1 create studiobook` and its
  // database_id is set here (or in CI via Wrangler secrets). Migrations are
  // applied with `wrangler d1 migrations apply studiobook`.
  // The secret RESEND_API_KEY is set out-of-band with `wrangler secret put`.
  "name": "studiobook",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook",
      "database_id": "YOUR_DATABASE_ID",
      "migrations_dir": "./migrations",
    },
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://studiobook.example",
  },
  "observability": {
    "enabled": true,
  },
}
