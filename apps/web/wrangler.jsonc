{
  // Production wrangler config for Studiobook (a benchmark fixture app).
  // Deploys apps/web as a Cloudflare Worker via @opennextjs/cloudflare.
  //
  // NEXT_PUBLIC_* vars are public (inlined into the client bundle at build time).
  // The secret RESEND_API_KEY is set out-of-band with `wrangler secret put
  // <NAME>` — never commit it. Persistence is the `DB` D1 binding below, left
  // as a "draft" binding (no database_id): `wrangler deploy` auto-provisions
  // it by database_name on first deploy and reconnects to it on every deploy
  // after that.
  "name": "studiobook",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://studiobook.example",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
