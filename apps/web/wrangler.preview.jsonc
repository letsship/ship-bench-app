{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Preview environments share ONE seeded Cloudflare D1 database (there is no
  // ephemeral per-PR database). The deploy-preview workflow rewrites the "DB"
  // binding's database_id/database_name below to the shared preview D1, applies
  // ./migrations, and seeds it; RESEND_API_KEY is set as a Worker secret after
  // deploy. See the README's deploy section.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
