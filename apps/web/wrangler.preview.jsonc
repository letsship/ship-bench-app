{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Preview environments read/write the same D1 binding as production (there is
  // no ephemeral per-PR database). The deploy-preview workflow sets the
  // RESEND_API_KEY Worker secret after deploy. See the README's deploy section.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook",
      "database_id": "REPLACE_ME_WITH_WRANGLER_D1_CREATE_OUTPUT",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
