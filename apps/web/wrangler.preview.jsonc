{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Each preview environment gets its own ephemeral D1 database (database_id_preview).
  // The deploy-preview workflow sets RESEND_API_KEY as a Worker secret after deploy.
  // See the README's deploy section.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook-preview",
      "database_id": "11111111-1111-1111-1111-111111111111",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
