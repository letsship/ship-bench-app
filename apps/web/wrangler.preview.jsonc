{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Preview environments get their own D1 database (one per preview, via the
  // deploy-preview workflow, which also applies migrations and sets the
  // RESEND_API_KEY Worker secret after deploy). The d1_databases binding
  // mirrors wrangler.jsonc so the OpenNext preview build resolves DB
  // consistently. See the README's deploy section.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook-preview",
      "database_id": "<replace-with-d1-database-id>",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
