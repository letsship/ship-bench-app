{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Preview environments get their own D1 database (provisioned by the deploy-preview
  // workflow). The workflow applies the migration and seed SQL, so each preview has
  // the identical demo dataset.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook-preview",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
