{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Preview environments use the same Cloudflare D1 stack as production: the
  // `DB` D1 binding is declared here and migrated with the SQL under
  // ./migrations. The deploy-preview workflow sets `RESEND_API_KEY` (and any
  // other email secret) as a Worker secret after deploy. See the README's
  // deploy section.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook-preview",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
