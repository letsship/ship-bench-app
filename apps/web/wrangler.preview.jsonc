{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Preview environments share ONE D1 database (there is no ephemeral per-PR
  // database): the deploy-preview workflow points the DB binding below at the
  // shared preview D1, applies apps/web/migrations, and reseeds it before every
  // deploy. RESEND_API_KEY is set as a Worker secret after deploy. See the
  // README's deploy section.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
