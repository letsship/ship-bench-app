{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Preview environments share ONE seeded D1 database (there is no ephemeral
  // per-PR database). The deploy-preview workflow greps this config for
  // "d1_databases", rewrites the placeholder database_id to the shared preview DB,
  // resets it, applies the migration, and seeds via scripts/emit-seed-sql.ts.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook",
      "database_id": "placeholder",
    },
  ],
  "migrations_dir": "migrations",
  "observability": {
    "enabled": true,
  },
}
