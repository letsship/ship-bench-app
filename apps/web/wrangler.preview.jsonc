{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // The `DB` binding below tells deploy-preview CI to provision a per-PR D1
  // database. RESEND_API_KEY is set as a Worker secret after deploy. See the
  // README's deploy section.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook-preview",
      "database_id": "REPLACE_ME",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
