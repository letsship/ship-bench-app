{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Preview environments share ONE seeded Supabase project (there is no ephemeral
  // per-PR database). The deploy-preview workflow supplies the NEXT_PUBLIC_*
  // Supabase vars at build time and sets SUPABASE_SECRET_KEY + RESEND_API_KEY as
  // Worker secrets after deploy. See the README's deploy section.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
