{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Preview environments share ONE seeded D1 database (there is no ephemeral
  // per-PR database — see the D1 binding below). The deploy-preview workflow
  // sets RESEND_API_KEY as a Worker secret after deploy. See the README's
  // deploy section.
  //
  // The D1 binding below is intentionally left as a "draft" binding (no
  // database_id): `wrangler deploy` auto-provisions it on first deploy and
  // reconnects to the existing database by database_name on every deploy
  // after that — no manual database_id to keep in sync.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook-preview",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
