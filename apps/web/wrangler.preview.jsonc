{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Preview persistence is a D1 database bound as DB. The deploy-preview
  // workflow provisions/points the binding at a preview database (overriding
  // database_id as needed), applies apps/web/migrations/, and sets
  // RESEND_API_KEY as a Worker secret after deploy. See the README's deploy
  // section.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook-preview",
      "database_id": "REPLACE_WITH_PREVIEW_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
