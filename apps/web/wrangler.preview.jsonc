{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Preview environments use a preview D1 database (ephemeral per-PR, or shared).
  // The deploy-preview workflow supplies NEXT_PUBLIC_SITE_URL and RESEND_API_KEY
  // as secrets after deploy. See the README's deploy section.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook-preview",
      "database_id": "REPLACE_WITH_PREVIEW_DATABASE_ID",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
