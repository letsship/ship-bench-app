{
  // Route-less preview config — deploys to *.workers.dev ONLY. The per-PR worker
  // name is supplied by the SHIP orchestrator via `wrangler deploy --name`.
  //
  // Preview environments each get their own D1 database via the SHIP workflow:
  //   wrangler d1 create studiobook-preview-{PR_NUMBER}
  // and the database_id is injected at deploy time. The secret RESEND_API_KEY
  // is set as a Worker secret after deploy.
  "name": "studiobook-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiobook-preview",
      "database_id": "YOUR_PREVIEW_DATABASE_ID",
      "migrations_dir": "./migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
