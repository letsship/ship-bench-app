{
  "name": "studiobook",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:migrate": "supabase migration up",
    "supabase:types": "supabase gen types typescript --local --schema public > apps/web/lib/db/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "supabase": "^2.20.0",
    "turbo": "^2.8.3"
  },
  "pnpm": {
    "overrides": {
      "semver": ">=7.5.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase",
      "workerd"
    ]
  }
}
